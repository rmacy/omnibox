#!/usr/bin/env bash
set -euo pipefail

target=${1:-}
expected="$HOME/.local/state/omnibox/usage.json"
[[ $target == "$expected" ]] || {
  printf 'write-usage: refusing unexpected target: %s\n' "$target" >&2
  exit 64
}

state_dir=${target%/*}
umask 077
mkdir -p -- "$state_dir"
chmod 700 -- "$state_dir"

IFS= read -r payload
[[ -n $payload ]] || payload='{}'

tmp=$(mktemp "$state_dir/.usage.json.tmp.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
printf '%s' "$payload" >"$tmp"
chmod 600 -- "$tmp"
mv -f -- "$tmp" "$target"
chmod 600 -- "$target"
trap - EXIT HUP INT TERM
