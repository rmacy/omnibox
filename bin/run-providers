#!/usr/bin/env bash

set -uo pipefail

usage() {
  printf 'usage: %s <query> <context-json> <unrestricted-provider-ids-json> <manifest-path...>\n' "${0##*/}" >&2
  exit 2
}

(( $# >= 3 )) || usage
query=$1
context_json=$2
unrestricted_json=$3
shift 3
jq -e 'type == "object"' <<<"$context_json" >/dev/null 2>&1 || context_json='{}'
jq -e 'type == "array" and all(.[]; type == "string")' <<<"$unrestricted_json" >/dev/null 2>&1 || unrestricted_json='[]'

clamp() {
  local value=$1 fallback=$2 minimum=$3 maximum=$4
  [[ $value =~ ^[0-9]+$ ]] || value=$fallback
  (( value < minimum )) && value=$minimum
  (( value > maximum )) && value=$maximum
  printf '%s' "$value"
}

seconds_from_ms() {
  printf '%d.%03d' "$(( $1 / 1000 ))" "$(( $1 % 1000 ))"
}

ids=()
executables=()
bodies=()
contexts=()
timeouts=()
kills=()
row_limits=()
byte_limits=()
query_lower=${query,,}

for manifest_path in "$@"; do
  [[ $manifest_path == /* && -f $manifest_path && ! -L $manifest_path ]] || continue
  protocol=$(jq -r '.protocol // 0' "$manifest_path" 2>/dev/null || true)
  enabled=$(jq -r '.enabled // false' "$manifest_path" 2>/dev/null || true)
  id=$(jq -r '.id // ""' "$manifest_path" 2>/dev/null || true)
  executable_name=$(jq -r '.executable // ""' "$manifest_path" 2>/dev/null || true)
  policy=$(jq -r '.queryPolicy // "triggered"' "$manifest_path" 2>/dev/null || true)
  [[ $protocol == 2 && $enabled == true ]] || continue
  [[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || continue
  [[ $executable_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || continue
  [[ $policy == triggered || $policy == unrestricted ]] || continue
  if [[ $policy == unrestricted ]]; then
    jq -e --arg id "$id" 'index($id) != null' <<<"$unrestricted_json" >/dev/null 2>&1 || continue
    body=$query
  else
    matched=
    body=$query
    while IFS= read -r trigger; do
      trigger=${trigger,,}
      [[ $trigger =~ ^[a-z0-9][a-z0-9._\ -]{0,31}$ ]] || continue
      if [[ $query_lower == "$trigger" ]]; then
        matched=1
        body=
        break
      elif [[ $query_lower == "$trigger "* || $query_lower == "$trigger:"* ]]; then
        matched=1
        body=${query:${#trigger}+1}
        body=${body# }
        break
      fi
    done < <(jq -r '.triggers[]? // empty' "$manifest_path" 2>/dev/null)
    [[ -n $matched ]] || continue
  fi

  source_dir=${manifest_path%/*}
  executable=$source_dir/$executable_name
  [[ -f $executable && -x $executable && ! -L $executable ]] || continue
  filtered_context=$(jq -cn \
    --argjson context "$context_json" \
    --slurpfile manifest "$manifest_path" \
    '$manifest[0].context // [] as $allowed | $context | with_entries(select(.key as $key | $allowed | index($key)))' \
    2>/dev/null || printf '{}')
  timeout_ms=$(clamp "$(jq -r '.timeoutMs // 900' "$manifest_path")" 900 100 5000)
  kill_ms=$(clamp "$(jq -r '.killAfterMs // 200' "$manifest_path")" 200 50 1000)
  max_rows=$(clamp "$(jq -r '.maxRows // 8' "$manifest_path")" 8 1 32)
  max_bytes=$(clamp "$(jq -r '.maxLineBytes // 16384' "$manifest_path")" 16384 256 16384)
  ids+=("$id")
  executables+=("$executable")
  bodies+=("$body")
  contexts+=("$filtered_context")
  timeouts+=("$(seconds_from_ms "$timeout_ms")")
  kills+=("$(seconds_from_ms "$kill_ms")")
  row_limits+=("$max_rows")
  byte_limits+=("$max_bytes")
done

(( ${#ids[@]} > 0 )) || exit 0
umask 077
temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/run-providers.XXXXXXXX") || exit 1
lock_file=$(mktemp "$temp_dir/lock.XXXXXXXX") || exit 1
exec {publication_lock}>"$lock_file"
outputs=()
pids=()
declare -A indexes_by_pid=()
cleaning=0
cleanup() {
  (( cleaning == 0 )) || return
  cleaning=1
  trap - EXIT HUP INT TERM
  local pid
  for pid in "${pids[@]}"; do
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  done
  for pid in "${pids[@]}"; do
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  done
  for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
  exec {publication_lock}>&-
  rm -f -- "${outputs[@]}" "$lock_file"
  rmdir "$temp_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

publish() {
  local index=$1 output=$2 count=0 line wrapped
  local LC_ALL=C
  flock -x "$publication_lock" || return
  while IFS= read -r line && (( count < ${row_limits[index]} )); do
    line=${line:0:${byte_limits[index]}}
    wrapped=$(jq -ce --arg providerId "${ids[index]}" '{providerId:$providerId,result:.}' <<<"$line" 2>/dev/null || true)
    [[ -n $wrapped ]] || continue
    printf '%s\n' "$wrapped"
    count=$((count + 1))
  done <"$output"
  flock -u "$publication_lock" || true
}

for (( index = 0; index < ${#ids[@]}; index++ )); do
  output=$(mktemp "$temp_dir/provider.XXXXXXXX") || exit 1
  outputs+=("$output")
  timeout --kill-after="${kills[index]}" "${timeouts[index]}" \
    "${executables[index]}" "${bodies[index]}" "${contexts[index]}" >"$output" 2>/dev/null &
  pid=$!
  pids+=("$pid")
  indexes_by_pid["$pid"]=$index
done

while (( ${#pids[@]} > 0 )); do
  completed_pid=
  wait -n -p completed_pid "${pids[@]}" || true
  [[ -n $completed_pid ]] || continue
  completed_index=${indexes_by_pid[$completed_pid]}
  publish "$completed_index" "${outputs[completed_index]}"
  unset 'indexes_by_pid[$completed_pid]'
  remaining=()
  for pid in "${pids[@]}"; do [[ $pid == "$completed_pid" ]] || remaining+=("$pid"); done
  pids=("${remaining[@]}")
done

exit 0
