#!/usr/bin/env bash
set -euo pipefail

(( $# >= 5 )) || {
  printf 'usage: %s <max-depth> <max-results> <timeout> <kill-after> <pattern> [root ...]\n' "${0##*/}" >&2
  exit 2
}

max_depth=$1
max_results=$2
timeout_seconds=$3
kill_after_seconds=$4
pattern=$5
shift 5

[[ $max_depth =~ ^[1-9][0-9]*$ ]] || exit 2
[[ $max_results =~ ^[1-9][0-9]*$ ]] || exit 2
[[ $timeout_seconds =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 2
[[ $kill_after_seconds =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 2
(( $# > 0 )) || exit 0
command -v fd >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

count=0
timeout --kill-after="$kill_after_seconds" "$timeout_seconds" \
  fd -0 -d "$max_depth" -E .git -E node_modules -E .cache -E Trash \
    -t f -t d -t l --color never -- "$pattern" "$@" 2>/dev/null \
  | while IFS= read -r -d '' path; do
      is_dir=false
      [[ -d $path ]] && is_dir=true
      [[ $is_dir == true ]] && path=${path%/}
      jq -cn --arg path "$path" --argjson isDir "$is_dir" '{path:$path,isDir:$isDir}'
      count=$((count + 1))
      (( count < max_results )) || break
    done
