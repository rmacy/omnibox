#!/usr/bin/env bash
set -euo pipefail

(( $# >= 5 )) || {
  printf 'usage: %s <max-depth> <max-results> <timeout> <kill-after> <pattern> [root ...]\n' "${0##*/}" >&2
  exit 2
}

max_depth=$1
max_results=$2
timeout_seconds=$3
kill_after_seconds=$4
pattern=$5
shift 5

[[ $max_depth =~ ^[1-9][0-9]*$ ]] || exit 2
[[ $max_results =~ ^[1-9][0-9]*$ ]] || exit 2
[[ $timeout_seconds =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 2
[[ $kill_after_seconds =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 2
(( $# > 0 )) || exit 0
command -v fd >/dev/null 2>&1 || exit 0

timeout --kill-after="$kill_after_seconds" "$timeout_seconds" \
  fd -d "$max_depth" -E .git -E node_modules -E .cache -E Trash \
    -t f -t d -t l --color never -- "$pattern" "$@" 2>/dev/null \
  | head -n "$max_results"
