#!/usr/bin/env bash
# Omnibox provider v2: search a cached installed-package inventory.
# argv: $1 = trigger-stripped query, $2 = allowlisted context JSON.
# stdout: one typed protocol-2 JSON result per line.
set -euo pipefail

q=${1:-}
[[ -n $q ]] || exit 0
command -v pacman >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omnibox
cache_file=$cache_dir/packages.tsv
lock_file=$cache_dir/packages.lock
pacman_db=${OMNIBOX_PACMAN_DB:-/var/lib/pacman/local}
umask 077
mkdir -p -- "$cache_dir"
chmod 700 -- "$cache_dir"

(
  flock -x 9
  if [[ ! -s $cache_file || $pacman_db -nt $cache_file ]]; then
    tmp=$(mktemp "$cache_dir/.packages.tsv.tmp.XXXXXX")
    trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
    if pacman -Q >"$tmp" 2>/dev/null; then
      chmod 600 -- "$tmp"
      mv -f -- "$tmp" "$cache_file"
      chmod 600 -- "$cache_file"
      trap - EXIT HUP INT TERM
    elif [[ ! -s $cache_file ]]; then
      exit 0
    fi
  fi
) 9>"$lock_file"

[[ -r $cache_file ]] || exit 0
count=0
while read -r name version; do
  [[ ${name,,} == *${q,,}* ]] || continue
  identity=$(printf '%s' "$name" | sha256sum | cut -c1-16)
  jq -cn \
    --arg id "package:$identity" \
    --arg title "$name" \
    --arg subtitle "$version · installed" \
    --arg package "$name" \
    '{
      protocol:2,
      id:$id,
      type:"provider",
      title:$title,
      subtitle:$subtitle,
      icon:"󰣇",
      value:{package:$package},
      actions:[{
        id:"package.info",
        title:"Package info",
        executor:"argv",
        argv:["xdg-terminal-exec","--hold","--","pacman","-Qi","--",$package],
        lifecycle:"close",
        risk:"safe"
      }]
    }'
  count=$((count + 1))
  (( count < 8 )) || break
done <"$cache_file"
